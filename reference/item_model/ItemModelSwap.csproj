<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>ItemModelSwap</AssemblyName>
    <RootNamespace>ItemModelSwap</RootNamespace>

    <!-- 游戏目录：export DUCKOV_DIR=<游戏安装目录>（或跑 validate_mod，它会带上） -->
    <DuckovDir Condition="'$(DUCKOV_DIR)' != ''">$(DUCKOV_DIR)</DuckovDir>
    <IsMac Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsMac>
    <ManagedDir Condition="'$(IsMac)' == 'true'">$(DuckovDir)/Duckov.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(IsMac)' != 'true'">$(DuckovDir)/Duckov_Data/Managed</ManagedDir>
  </PropertyGroup>

  <Target Name="RequireDuckovDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(DuckovDir)' == ''"
      Text="DUCKOV_DIR is not set. Export it (export DUCKOV_DIR=&quot;&lt;game install dir&gt;&quot;) or run validate_mod, which passes it." />
  </Target>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/TeamSoda.*"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)/ItemStatsSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)/Unity*"><Private>false</Private></Reference>
  </ItemGroup>

  <!-- 运行时库（libs/mod-kit）：这个示例 mod 只写配置，能力都在库里 -->
  <ItemGroup>
    <!-- 运行时库（libs/mod-kit）：**通配** ✓ —— kit 加文件不用再改 csproj ✗ -->
    <Compile Include="../../libs/mod-kit/*.cs" />
  </ItemGroup>
</Project>
