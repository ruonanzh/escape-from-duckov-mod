<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>CubePerson</AssemblyName>
    <RootNamespace>CubePerson</RootNamespace>

    <!-- Game dir: `node tools/check_runtime.mjs` discovers it and caches to
         .gamer-agent.local.json; export DUCKOV_DIR=<gameDir> before building.
         Override manually here for local dev. -->
    <DuckovDir Condition="'$(DUCKOV_DIR)' != ''">$(DUCKOV_DIR)</DuckovDir>

    <IsMac Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsMac>
    <ManagedDir Condition="'$(IsMac)' == 'true'">$(DuckovDir)/Duckov.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(IsMac)' != 'true'">$(DuckovDir)/Duckov_Data/Managed</ManagedDir>
  </PropertyGroup>

    <!-- 护栏（U25）：DuckovDir 为空时**直接报错**，而不是让引用静默缺失、编出空壳 dll。
         validate_mod 会自动带上 DUCKOV_DIR；手工 dotnet build 时必须自己 export。 -->
    <Target Name="RequireDuckovDir" BeforeTargets="ResolveAssemblyReferences">
      <Error Condition="'$(DuckovDir)' == ''"
        Text="DUCKOV_DIR is not set. Export it (export DUCKOV_DIR=&quot;&lt;game install dir&gt;&quot;) or run validate_mod, which passes it. Without it the game references resolve to nothing and the build silently produces an empty stub DLL." />
    </Target>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/TeamSoda.*">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ManagedDir)/ItemStatsSystem.dll">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(ManagedDir)/Unity*">
      <Private>false</Private>
    </Reference>
    <Reference Include="$(MSBuildThisFileDirectory)../../libs/0Harmony.dll">
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <!-- 共享层 + 运行时适配器（见 reference/mod-kit/README.md）-->
  <ItemGroup>
    <Compile Include="../mod-kit/Json.cs" />
    <Compile Include="../mod-kit/ModelJson.cs" />
    <Compile Include="../mod-kit/MeshKit.cs" />
    <Compile Include="../mod-kit/TextureKit.cs" />
    <Compile Include="../mod-kit/UnityAdapter.cs" />
    <Compile Include="../mod-kit/ModelLoader.cs" />
    <Compile Include="../mod-kit/GameApi.cs" />
    <Compile Include="../mod-kit/CharacterModelReplacer.cs" />
  </ItemGroup>
</Project>
