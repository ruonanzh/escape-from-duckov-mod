<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AssemblyName>BundleSwap</AssemblyName>
    <RootNamespace>BundleSwap</RootNamespace>
    <DuckovDir Condition="'$(DUCKOV_DIR)' != ''">$(DUCKOV_DIR)</DuckovDir>
    <IsMac Condition="$([MSBuild]::IsOSPlatform('OSX'))">true</IsMac>
    <ManagedDir Condition="'$(IsMac)' == 'true'">$(DuckovDir)/Duckov.app/Contents/Resources/Data/Managed</ManagedDir>
    <ManagedDir Condition="'$(IsMac)' != 'true'">$(DuckovDir)/Duckov_Data/Managed</ManagedDir>
  </PropertyGroup>
  <Target Name="RequireDuckovDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(DuckovDir)' == ''" Text="DUCKOV_DIR is not set." />
  </Target>
  <ItemGroup>
    <Reference Include="$(ManagedDir)/TeamSoda.*"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)/ItemStatsSystem.dll"><Private>false</Private></Reference>
    <Reference Include="$(ManagedDir)/Unity*"><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../mod-kit/Json.cs" />
    <Compile Include="../mod-kit/ModelJson.cs" />
    <Compile Include="../mod-kit/MeshKit.cs" />
    <Compile Include="../mod-kit/TextureKit.cs" />
    <Compile Include="../mod-kit/UnityAdapter.cs" />
    <Compile Include="../mod-kit/ModelLoader.cs" />
    <Compile Include="../mod-kit/GameApi.cs" />
    <Compile Include="../mod-kit/GltfLoader.cs" />
  </ItemGroup>
</Project>
