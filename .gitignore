# 运行时状态（玩家机器特定，不进 git）
.gamer-agent.local.json

# 中间产物（预览图 / 渲染图 / 概念图）—— 只给人看，不进游戏
.preview/

# 编译产物
**/bin/
**/obj/

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# 编辑器
.vscode/
.idea/

# 本仓不装 npm 依赖；node_modules 只可能是临时产物（别提交 ✗）
node_modules/

# 构建时从 libs/ 复制到 mod 根（install_mod 只拷 mod 根）。
# 收窄到这两个位置：写成 **/0Harmony.dll 会连已跟踪的 libs/0Harmony.dll 一起匹配，
# 那会让「删掉再 git add」被挡住。
reference/**/0Harmony.dll
your_mods/**/0Harmony.dll
